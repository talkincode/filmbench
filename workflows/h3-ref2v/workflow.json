{
  "schema": "filmbench/workflow/v1",
  "name": "h3-ref2v",
  "title": "MiniMax H3 参考图/参考视频生视频",
  "gpu": "A100",
  "defaults": { "width": 768, "height": 1024, "length": 124, "fps": 24, "steps": 24, "seed": 7101, "refImageSize": "match" },
  "capabilities": {
    "firstFrame": false,
    "lastFrame": false,
    "referenceImages": true,
    "referenceVideos": false,
    "controlVideo": false
  },
  "models": [
    "diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors",
    "text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
    "vae/minimax_h3_video_vae_fp16.safetensors",
    "vae/minimax_h3_audio_vae_fp32.safetensors"
  ],
  "run": "run.py",
  "setup": "setup.py",
  "out": "/content/filmbench/out/{jobId}.mp4",
  "pips": [],
  "env": {},
  "notes": "参考图最多 9 张，prompt 里用 <Picture i> 指代（i 从 1 开始）；参考视频能力已在节点里，但本版本未接"
}
