{
  "name": "filmbench",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "本地视频编排工作台：事件日志 + sqlite 索引 + provider 作业 + 编译出片 + 审计故事板 + stdio MCP + pi agent",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "cli": "bun packages/cli/src/cli.ts",
    "demo": "bun packages/cli/src/cli.ts demo demo-project",
    "storyboard:demo": "bun packages/storyboard-audit/src/cli.ts --in packages/storyboard-audit/fixtures/demo.storyboard.json --out out/storyboard.html",
    "desktop": "cd apps/desktop && bun run dev",
    "test": "bun test",
    "dev": "bash scripts/dev.sh",
    "dev:check": "bash scripts/dev.sh --check",
    "dev:reset": "bash scripts/dev.sh --reset"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "files": [
    "packages",
    "apps",
    "workflows",
    "skills",
    "docs",
    "README.md",
    "AGENTS.md"
  ]
}
